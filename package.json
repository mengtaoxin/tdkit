{
  "name": "@mengtaoxin/tdkit",
  "version": "0.3.0",
  "description": "A TypeScript library for the browser",
  "keywords": [
    "browser",
    "dexie",
    "indexeddb",
    "library",
    "logging",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengtaoxin/tdkit.git"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "dexie": "^4.4.6"
  },
  "devDependencies": {
    "@mengtaoxin/oxc-config": "^0.2.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
